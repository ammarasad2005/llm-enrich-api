# The THREE variables that are the only difference between a local model and a
# datacentre one. Swap provider by changing just these:
#
#   OpenRouter (hosted):  LLM_BASE_URL=https://openrouter.ai/api/v1
#                         LLM_API_KEY=sk-or-v1-...        (from openrouter.ai/keys)
#                         LLM_MODEL=minimax/minimax-m3:free
#
#   Ollama (local):       LLM_BASE_URL=http://localhost:11434/v1/
#                         LLM_API_KEY=ollama              (required but ignored)
#                         LLM_MODEL=gemma3:1b
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=your_provider_key_here
LLM_MODEL=minimax/minimax-m3:free

PORT=3000

# LLM_STUB=1     -> skip the model, return a fixed schema-valid stub (build without spending quota)
LLM_STUB=0
# LLM_ENABLED=false -> kill switch: skip the model, return a safe deterministic fallback
LLM_ENABLED=true
# The prompt version to load from prompts/ and stamp into cost/cache logs
PROMPT_VERSION=v1
